{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zefirok-run",
	"main": "src/worker.js",
	"compatibility_date": "2026-07-23",
	"observability": {
		"enabled": true
	},
	"build": {
		"command": "node scripts/check-assets.mjs --news-manifest && node scripts/check-assets.mjs --new-only && node scripts/check-live-content-assets.mjs"
	},
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zefirok-rewards",
			"database_id": "5b92319d-9868-4e20-8677-4a140390255d",
			"migrations_dir": "migrations",
			"remote": true
		},
		{
			"binding": "zefirok_candidate_v4_daily",
			"database_name": "zefirok-candidate-v4-daily",
			"database_id": "6fd7a773-9956-4f30-92df-0a8472fbb696"
		}
	],
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	}
}

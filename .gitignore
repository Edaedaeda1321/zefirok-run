# Legacy development copies must not return to production root
/*.patch
/*.diff
/*_test.html
/*_testing*.html
/*New_Version*.html

# Git history is the only commit identity source
/BASE_COMMIT.txt

# iOS local build state
/ios/**/xcuserdata/
/ios/**/DerivedData/
/ios/**/.swiftpm/

# Local Story World installer backups / generated offline bundle
.world-story-v1-backup/
.story-standalone-output/
story-world-preview.html
START_STORY_WORLD.html
START_STORY_WORLD_v1.html
